{
  "name": "@engenty/wizards-run",
  "version": "0.1.0",
  "description": "Runs a wizard of engenty wizards in this terminal: at your organization, or on this computer alone with Ollama or your own API key. The command wizards-run, and the host for one run in a Node process that engenty wizards’ own `wizards run` uses.",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "bin": {
    "wizards-run": "./bin/wizards-run.mjs"
  },
  "exports": {
    "./*": {
      "wizards-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@engenty/wizards-engine": "workspace:*",
    "@engenty/wizards-shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2"
  }
}
