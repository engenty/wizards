{
  "name": "@engenty/goose",
  "version": "0.1.0",
  "description": "Goose, the copilot: steps, tool calls and server-sent events around a chat with tools, a tool registry, and adapters for the Anthropic and OpenAI SDKs and the Vercel AI SDK.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engenty/wizards.git",
    "directory": "packages/goose"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "wizards-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anthropic": {
      "wizards-source": "./src/adapters/anthropic.ts",
      "types": "./dist/adapters/anthropic.d.ts",
      "default": "./dist/adapters/anthropic.js"
    },
    "./openai": {
      "wizards-source": "./src/adapters/openai.ts",
      "types": "./dist/adapters/openai.d.ts",
      "default": "./dist/adapters/openai.js"
    },
    "./sdk": {
      "wizards-source": "./src/adapters/sdk.ts",
      "types": "./dist/adapters/sdk.d.ts",
      "default": "./dist/adapters/sdk.js"
    },
    "./ai-sdk": {
      "wizards-source": "./src/adapters/ai-sdk.ts",
      "types": "./dist/adapters/ai-sdk.d.ts",
      "default": "./dist/adapters/ai-sdk.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.3.0",
    "ai": ">=7.0.0",
    "hono": "^4.6.0",
    "openai": ">=7.0.0",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/node": "^26.6.6",
    "ai": "7.0.163",
    "hono": "^4.13.16",
    "openai": "^7.45.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  }
}
