{
  "name": "@engenty/wizards",
  "version": "0.1.0",
  "description": "What your code imports from engenty wizards: plugins at /plugin, wizards in OpenUI chats at /openui.",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./plugin": {
      "wizards-source": "./src/plugin/index.ts",
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./plugin/studio": {
      "wizards-source": "./src/plugin/studio.ts",
      "types": "./dist/plugin/studio.d.ts",
      "default": "./dist/plugin/studio.js"
    },
    "./plugin/thread": {
      "wizards-source": "./src/plugin/thread.ts",
      "types": "./dist/plugin/thread.d.ts",
      "default": "./dist/plugin/thread.js"
    },
    "./openui": {
      "wizards-source": "./src/openui/index.ts",
      "types": "./dist/openui/index.d.ts",
      "default": "./dist/openui/index.js"
    },
    "./openui/server": {
      "wizards-source": "./src/openui/server.ts",
      "types": "./dist/openui/server.d.ts",
      "default": "./dist/openui/server.js"
    },
    "./openui/styles.css": "./src/openui/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "^1.0.1",
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.5"
  },
  "peerDependenciesMeta": {
    "@openuidev/react-lang": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@engenty-wizards/runner": "workspace:*",
    "@engenty-wizards/shared": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@openuidev/react-lang": "1.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-orm": "^0.45.3",
    "jsdom": "^30.1.3",
