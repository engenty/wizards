{
  "name": "@engenty/model-providers",
  "version": "0.1.0",
  "description": "Every way an app reaches a model, apart from where it keeps its keys: the servers for open models on a person's own computer (Ollama, LM Studio and Apple MLX: their models, what each can do, downloads, a model with the context length set), the AI clients signed in on their subscription (Claude Code, Codex, Antigravity, Cursor Agent: found, signed in, run headless as a model or as a chat with one MCP server), the providers a person brings a key for (OpenAI, Anthropic, Google, OpenRouter, the Vercel AI Gateway and more: who they are, the test of a key, a model on it), the wizards account, and a short real call that says whether each answers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engenty/wizards.git",
    "directory": "packages/model-providers"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "wizards-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ollama": {
      "wizards-source": "./src/ollama/index.ts",
      "types": "./dist/ollama/index.d.ts",
      "default": "./dist/ollama/index.js"
    },
    "./lmstudio": {
      "wizards-source": "./src/lmstudio/index.ts",
      "types": "./dist/lmstudio/index.d.ts",
      "default": "./dist/lmstudio/index.js"
    },
    "./mlx": {
      "wizards-source": "./src/mlx/index.ts",
      "types": "./dist/mlx/index.d.ts",
      "default": "./dist/mlx/index.js"
    },
    "./servers": {
      "wizards-source": "./src/servers/index.ts",
      "types": "./dist/servers/index.d.ts",
      "default": "./dist/servers/index.js"
    },
    "./clients": {
      "wizards-source": "./src/clients/index.ts",
      "types": "./dist/clients/index.d.ts",
      "default": "./dist/clients/index.js"
    },
    "./providers": {
      "wizards-source": "./src/providers/index.ts",
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./providers/model": {
      "wizards-source": "./src/providers/model.ts",
      "types": "./dist/providers/model.d.ts",
      "default": "./dist/providers/model.js"
    },
    "./account": {
      "wizards-source": "./src/account.ts",
      "types": "./dist/account.d.ts",
      "default": "./dist/account.js"
    },
    "./probe": {
      "wizards-source": "./src/probe.ts",
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    },
    "./bridge": {
      "wizards-source": "./src/bridge/index.ts",
      "types": "./dist/bridge/index.d.ts",
      "default": "./dist/bridge/index.js"
    }
  },
  "files": [
    "dist",
    "mlx/bin",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/gateway": "^4.0.136",
    "@ai-sdk/google": "4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@modelcontextprotocol/server": "2.4.0",
    "cross-spawn": "7.0.6"
  },
  "peerDependencies": {
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "ai": "7.0.163",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
