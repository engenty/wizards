{
  "version": "0.3.0",
  "title": "Offer",
  "description": "From a customer's request to a signed offer.",

  "requires": {
    "models": ["standard"],
    "roles": { "legal": "Legal" }
  },

  "input": {
    "fields": [
      { "id": "customer", "label": "Customer", "kind": "text", "required": true },
      { "id": "email", "label": "Their e-mail", "kind": "email", "required": true },
      { "id": "budget", "label": "Budget", "kind": "number" },
      {
        "id": "items",
        "label": "What they want",
        "kind": "items",
        "columns": [
          { "id": "name", "label": "Item", "kind": "text" },
          { "id": "price", "label": "Price", "kind": "money" },
          { "id": "quantity", "label": "Quantity", "kind": "number" }
        ]
      }
    ]
  },

  "start": "offer",
  "edges": {
    "offer": ["check", "legal", "offer"],
    "legal": ["check", "offer"],
    "check": ["accept", "offer"],
    "accept": ["signed", "end"],
    "signed": ["end", "chase"],
    "chase": ["end"]
  },
  "limits": { "legal": 3, "check": 3 },

  "output": {
    "offer": "offer.text",
    "price": "offer.price",
    "signed": "signed.came",
    "reminder": "chase.mail"
  }
}
