{
  "version": 2,
  "title": "Answer a customer",
  "description": "Reads the last thread with a customer, drafts an answer, and sends it once you say so.",

  "requires": {
    "models": ["standard"]
  },
  "connections": {
    "gmail": {
      "users.threads.list": "allow",
      "users.threads.get": "allow",
      "users.messages.send": "ask"
    }
  },

  "input": { "fields": [{ "id": "customer", "label": "Customer", "kind": "text" }] },

  "start": "work",
  "edges": {
    "work": ["look"],
    "look": ["send", "work"],
    "send": ["end"]
  },
  "limits": { "work": 3 },

  "output": { "sent": "send.id" }
}
