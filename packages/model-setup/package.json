{
  "name": "@engenty/model-setup",
  "version": "0.1.0",
  "description": "The setup in which a person picks what an app thinks with, shared by the engenty wizards studio and wizards.bot: the AI clients it offers, how each is found, installed and signed in through a terminal in the page, and the routes the page asks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engenty/wizards.git",
    "directory": "packages/model-setup"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "wizards-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "wizards-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@engenty/local-models": "workspace:*",
    "@lydell/node-pty": "1.1.0"
  },
  "peerDependencies": {
    "hono": "^4.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ai": "7.0.163",
    "hono": "^4.13.16",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  }
}
