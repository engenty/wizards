{
  "name": "@engenty/model-setup",
  "version": "0.1.0",
  "description": "The setup in which a person picks what an app thinks with, shared by the engenty wizards studio and wizards.bot: the AI clients it offers, how each is found, installed and signed in through a terminal in the page, the routes the page asks, and the page itself as React parts.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engenty/wizards.git",
    "directory": "packages/model-setup"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "wizards-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "wizards-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./texts": {
      "wizards-source": "./src/texts.ts",
      "types": "./dist/texts.d.ts",
      "default": "./dist/texts.js"
    },
    "./react": {
      "wizards-source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@engenty/chatviews": "workspace:*",
    "@engenty/local-models": "workspace:*",
    "@lydell/node-pty": "1.1.0"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "hono": "^4.6.0",
    "lucide-react": "^1.69.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.163",
    "hono": "^4.13.16",
    "lucide-react": "^1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  },
  "peerDependenciesMeta": {
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/addon-web-links": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
