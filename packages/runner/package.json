{
  "name": "@engenty/wizards-runner",
  "version": "0.1.0",
  "description": "The runner of engenty wizards: the components that draw a wizard's run, given a run source. MIT.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "wizards-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./check": {
      "wizards-source": "./src/check.ts",
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    },
    "./ui": {
      "wizards-source": "./src/ui.tsx",
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./i18n": {
      "wizards-source": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./theme.css": "./src/theme.css",
    "./runner.css": "./dist/runner.css"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node scripts/css.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@engenty/wizards-shared": "workspace:*",
    "dompurify": "^3.4.17",
    "fflate": "0.8.3",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "pdfmake": "0.3.12",
    "qr-scanner": "1.4.2"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
