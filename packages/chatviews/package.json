{
  "name": "@engenty/chatviews",
  "version": "0.1.0",
  "description": "Views in a chat and in a wizard: surfaces from a catalog of components bound to data by JSON pointer and calculations, their checks, and the calc language.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engenty/wizards.git",
    "directory": "packages/chatviews"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./surface": {
      "wizards-source": "./src/surface.ts",
      "types": "./dist/surface.d.ts",
      "default": "./dist/surface.js"
    },
    "./calc": {
      "wizards-source": "./src/calc.ts",
      "types": "./dist/calc.d.ts",
      "default": "./dist/calc.js"
    },
    "./shape": {
      "wizards-source": "./src/shape.ts",
      "types": "./dist/shape.d.ts",
      "default": "./dist/shape.js"
    },
    "./numbers": {
      "wizards-source": "./src/numbers.ts",
      "types": "./dist/numbers.d.ts",
      "default": "./dist/numbers.js"
    },
    "./react/surface": {
      "wizards-source": "./src/react/surface.tsx",
      "types": "./dist/react/surface.d.ts",
      "default": "./dist/react/surface.js"
    },
    "./react/ui": {
      "wizards-source": "./src/react/ui.tsx",
      "types": "./dist/react/ui.d.ts",
      "default": "./dist/react/ui.js"
    },
    "./react/field-looks": {
      "wizards-source": "./src/react/field-looks.tsx",
      "types": "./dist/react/field-looks.d.ts",
      "default": "./dist/react/field-looks.js"
    },
    "./react/markdown": {
      "wizards-source": "./src/react/markdown.tsx",
      "types": "./dist/react/markdown.d.ts",
      "default": "./dist/react/markdown.js"
    },
    "./react/texts": {
      "wizards-source": "./src/react/texts.ts",
      "types": "./dist/react/texts.d.ts",
      "default": "./dist/react/texts.js"
    },
    "./chat": {
      "wizards-source": "./src/chat/index.ts",
      "types": "./dist/chat/index.d.ts",
      "default": "./dist/chat/index.js"
    },
    "./react/chat": {
      "wizards-source": "./src/react/chat.tsx",
      "types": "./dist/react/chat.d.ts",
      "default": "./dist/react/chat.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@a2ui/web_core": "0.16.1",
    "@openuidev/lang-core": "1.1.0",
    "@openuidev/react-lang": "1.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.20.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@openuidev/lang-core": "1.1.0",
    "@openuidev/react-lang": "1.1.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@openuidev/lang-core": {
      "optional": true
    },
    "@openuidev/react-lang": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
