**/node_modules
**/dist
data
.env
.env.local
.git
.claude
# The runtime bundles the guides for its assistant (apps/runtime/src/assistant/docs.ts).
docs/*
!docs/content
apps/docs
# The client portal has an image of its own (apps/portal/Dockerfile), the sandbox too
# (deploy/Dockerfile.sandbox, with its own ignore file).
apps/portal
apps/sandbox
apps/runtime/test
examples
# The MIT libraries go to npm on their own (scripts/npm-package.mjs). The runtime doesn't use them
# yet, and its image installs only the manifests apps/runtime/Dockerfile copies: `pnpm build`
# would find them without their dependencies.
packages/decision-model
packages/search-index
packages/search-libsql
packages/goose
