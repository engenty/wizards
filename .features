# Feature flags of this checkout (an install: ~/.engenty/wizards/.features); the list: packages/shared/src/feature-flags.ts
# Same shape as .env: one `name=on` or `name=off` per line, `#` keeps the default.
# This file has the last word over the account's or team's switches from the Manage-App.
# A running runtime reads it at once; `wizards features` lists what counts.

# the account in a local install: linking, Settings → Account, the sign-in offer (on by default)
# account=on|off
#
# the two-way sync of a local install's spaces with its organization in the cloud (on by default)
# twoWaySync=on|off
#
# live changes: an open studio shows what changed elsewhere, and who else is in a wizard, page or table (on by default)
# liveChanges=on|off
#
# built-in connectors without an OAuth client, shown anyway
# unsetConnectors=on|off
#
# the link to the product's own site from the setup
# site=on|off
#
# the Team plan: the team page in the cloud studio, the plan on the account pages
# teamPlans=on|off
#
# the organization's settings in the cloud studio: name, members and invitations (instead of the account pages)
# organizationSettings=on|off
#
# sections of logos and colours (gradients, patterns) in info & brand
# brandSections=on|off
#
# rules for logos, colours and type in info & brand
# brandRules=on|off
#
# the brand's fonts in info & brand
# typography=on|off
#
# wizards run as a spoken conversation in the browser (off by default)
# channelVoice=on|off
#
# wizards run as a video call in the browser (off by default)
# channelVideo=on|off
#
# the WordPress plugin and a wizard as a package for it, in the share dialog and Integrate (off by default)
# wordpress=on|off
#
# Settings › Plugins before any plugin is installed (installing one turns it on)
# plugins=on|off
#
# Goose, the studio's assistant
# goose=on|off
#
# the organization's model tier: a step's maker, what calls are for, what each class runs on (off by default)
# modelTiers=on|off
#
# skills, a place of their own in the app bar: always on, or read by a wizard when it needs one (on by default)
# skills=on|off
#
# the organization's own domains for its wizards, in Settings → Allgemein (off by default)
# customDomains=on|off
#
# own API keys in the cloud studio (a plan's switch; on alone)
# ownKeys=on|off
#
# RWX rules per space, enforced at every reader (off by default)
# broker=on|off
#
# a plugin's switches carry its id; `wizards features` lists the ones installed here
# contacts.leadScoring=on|off
