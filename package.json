{
  "name": "engenty-wizards",
  "version": "0.7.6",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --conditions=wizards-source --clear-screen=false apps/runtime/src/index.ts",
    "dev:web": "pnpm --filter @engenty-wizards/web dev",
    "dev:docs": "pnpm --filter @engenty-wizards/docs dev",
    "dev:portless": "portless wizards pnpm dev",
    "build": "pnpm -r --filter \"!@engenty-wizards/docs\" build",
    "build:docs": "pnpm --filter @engenty-wizards/docs build",
    "docs:check": "node scripts/docs-check.mjs",
    "copy:check": "node scripts/copy-check.mjs",
    "start": "node apps/runtime/dist/index.js",
    "wizards": "node bin/wizards.mjs",
    "package": "node scripts/npm-package.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "db:generate": "pnpm --filter @engenty-wizards/runtime db:generate",
    "about:data": "node scripts/write-about-data.mjs",
    "schema": "tsx packages/shared/scripts/write-schema.ts",
    "release": "node scripts/release.mjs",
    "release:changelog": "node scripts/release.mjs --changelog",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "templates:export": "tsx --conditions=wizards-source scripts/export-templates.ts",
    "sandbox:add": "tsx apps/runtime/src/sandbox/install.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@engenty-wizards/shared": "workspace:*",
    "concurrently": "^10.0.6",
    "fflate": "0.8.3",
    "git-cliff": "^2.14.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
