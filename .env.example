# engenty wizards runs in one of two ways:
#   alone     — one person, one tenant, on this machine (desktop app, `pnpm dev`, own server).
#               Models come from own keys, a local model, or a linked account's credits.
#   managed   — MANAGE_URL is set: people sign in at the Manage-App, every tenant has its own
#               database, and model calls go through the Manage-App's model-gateway.

# --- Always -------------------------------------------------------------------
# The origin people open (links and callbacks use it). Empty: http://localhost:5181 from source
# (`pnpm dev`, the Vite dev server), http://localhost:<API_PORT> once built (`pnpm start`).
APP_URL=
# Default 24368, AGENT on a phone keypad. The Docker image listens on 8891.
# API_PORT=24368
# Listen address. Default: 127.0.0.1 alone, 0.0.0.0 managed.
API_HOST=
# What this process does: studio (authoring, sign-in, MCP, the studio's pages), doors (the
# wizards' pages, their API, shared results), web (both), runner (executes the runs in line) or
# all (everything, one process — a runtime that runs alone). The cloud runs studio, doors and
# runner apart.
RUNTIME_ROLE=all
# Where the wizards' pages are, when the doors run on an origin of their own: links to a wizard,
# a result or the embed script carry it. Default: APP_URL.
PUBLIC_URL=
# Where the web reaches this runner for a run's browser screen, e.g. http://runner:8891.
RUNNER_URL=
# The local install keeps its data in ~/.engenty/wizards/data and reads ~/.engenty/wizards/.env.
DATA_DIR=./data
# Signs cookies and links and derives the store's encryption key: openssl rand -hex 32.
# Alone, the runtime makes one itself and keeps it in DATA_DIR/secret. Required when managed.
APP_SECRET=

# --- Plugins (docs/content/dev/plugins) ------------------------------------------
# Folders to look for plugins in, comma-separated, besides the modules/ the runtime ships with.
# The local install looks in ~/.engenty/wizards/plugins. Code there runs with the runtime's rights.
# PLUGINS_DIR=examples/plugins
# Alone, a plugin loads again when one of its files changes. 0 turns that off.
# PLUGINS_WATCH=1
# Managed: ids of the plugins every tenant has; the Manage-App switches on further ones per tenant.
# PLUGINS_DEFAULT=

# --- Alone: models ---------------------------------------------------------------
# Keys can also be entered in the settings; the desktop app keeps them in the Keychain.
# One key serves text, image, video and web search (Vercel AI Gateway).
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Images, video and voices of other providers; bound in Settings → Models (fal:…, elevenlabs:…).
FAL_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
# What a search of Knowledge found is checked by TypeSafe's Jev: through the AI Gateway key above,
# the linked account's credits, or this key of TypeSafe's own. Without one, hits stay unchecked.
TYPESAFE_API_KEY=
# The same decision model picks the clicks of browser_run_fast in agent steps that use the
# browser, wherever one is reached. off: the step's own model does every click.
BROWSER_FAST_LOOP=
OLLAMA_URL=http://127.0.0.1:11434/v1
# What each model class runs on: [provider:]vendor/model, e.g. anthropic/claude-haiku-4.5,
# openai:gpt-5.4-mini, ollama:qwen3, fal:fal-ai/flux/schnell, elevenlabs:eleven_multilingual_v2,
# or credits (the linked account's credits). Steps name the class, never the model.
MODEL_CLASSIFIER=anthropic/claude-haiku-4.5
MODEL_STANDARD=anthropic/claude-haiku-4.5
MODEL_HIGH=anthropic/claude-sonnet-5.5
MODEL_HIGHEST=anthropic/claude-sonnet-5.5
MODEL_IMAGE=google/gemini-3.1-flash-image
MODEL_VIDEO=google/veo-3.1-fast-generate-001
# Audio transcribes voice notes; it must take audio files.
MODEL_AUDIO=google/gemini-3.5-flash-lite
# Speech reads a text aloud (voice-over of a film).
MODEL_SPEECH=google/gemini-3.8-flash-tts
# Embedding turns a project's documents into vectors for its index. Needs a key above (an
# installed AI client has no such model); without one the index searches by keywords.
MODEL_EMBEDDING=openai/text-embedding-3-small
# Names the place of a location field (street, town). Unset: coordinates only, and no
# position leaves this server. e.g. https://nominatim.openstreetmap.org/reverse
GEOCODER_URL=

# --- Alone: entering the studio and the optional account ---------------------------
# The studio answers only with a cookie set by a one-time link printed at start
# (the desktop app passes its own key here). Local development: a "Dev-Login" button instead.
LOCAL_ACCESS_KEY=
DEV_LOGIN=1
# 1: the studio assistant (Goose) offers its developer mode – each step's model, tokens, time and
# cost, the tools' arguments and results, the prompt, the turns' events. Managed: platform admins.
ASSISTANT_DEV=
# More host names this server answers under, besides APP_URL's and the loopback names.
ALLOWED_HOSTS=
# Where keys entered in the settings are kept: "keychain" (macOS) or empty = an encrypted file.
# The local install (`wizards`, the desktop app) uses the Keychain on a Mac.
SECRETS=
# The account service a local runtime can be linked to, its gateway, and the cloud runtime that
# gets what a linked install publishes (docs/manage-contract.md, "Spaces of a local install").
ACCOUNT_URL=https://account.engenty.ai
ACCOUNT_GATEWAY_URL=https://gateway.engenty.ai
CLOUD_URL=https://engenty.ai

# --- Marketplace: the wizards people start from (docs/marketplace-contract.md) --------
# The marketplace this runtime searches and keeps starters of. Default: https://engenty.ai/wizards.
# `off` = none.
MARKETPLACE_URL=

# --- Managed: the Manage-App this runtime belongs to (docs/manage-contract.md) --------
MANAGE_URL=
GATEWAY_URL=
# This runtime's OAuth client at the Manage-App; redirect: <APP_URL>/api/auth/callback
MANAGE_CLIENT_ID=
MANAGE_CLIENT_SECRET=
# Authenticates this runtime at the Manage-App and its gateway, and the Manage-App here.
MANAGE_SERVICE_KEY=

# --- Databases (libSQL) --------------------------------------------------------------
# The control database (links, run index, sessions). Empty = DATA_DIR/control.db.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# One database per tenant. Empty = files in DATA_DIR/tenants. On Turso the Manage-App hands
# out each tenant's URL; a template works without it: libsql://wz-{tenant}-yourorg.turso.io
TENANT_DB_URL_TEMPLATE=
TENANT_DB_AUTH_TOKEN=

# --- Files: assets and workspaces -------------------------------------------------------
# An S3-compatible bucket (Cloudflare R2). Empty = DATA_DIR/objects.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Limits for shared links -----------------------------------------------------------
LIMIT_VISITOR_RUNS_PER_HOUR=6
LIMIT_DEFAULT_DAILY_RUNS=50
# Runs of one tenant that work at the same time; more wait in line.
LIMIT_CONCURRENT_RUNS=4
# Wizards a local install may keep on this runtime in its synced project (a cloud runtime).
LIMIT_SYNCED_WIZARDS=50
# End-user results (no account) and their shared links are deleted after this many days.
RESULT_TTL_DAYS=7
# Cloudflare Turnstile (optional; shown before a public run starts)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The mobile app opens /w/ and /s/ links of this runtime (apps/mobile). Empty: the phone's browser.
# MOBILE_IOS_APP_IDS=7X9X3MSWJA.ai.engenty.wizards
MOBILE_IOS_APP_IDS=
MOBILE_ANDROID_PACKAGE=ai.engenty.wizards
MOBILE_ANDROID_CERT_SHA256=

# --- What wizards keep for a person (lists, files, connected accounts) --------------------
# Encrypts connected accounts and kept sign-ins: openssl rand -hex 32. Default: derived from APP_SECRET.
STORE_ENC_KEY=
# A person's store is deleted when nobody used it for this many days.
STORE_TTL_DAYS=400

# --- Connectors people sign in to (OAuth) ---------------------------------------------------
# Every client needs the redirect URI <APP_URL>/api/connect/callback (override: CONNECT_REDIRECT_URL).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
CONNECT_REDIRECT_URL=

# --- Browser, video, sandbox ------------------------------------------------------------------
# Chromium for PDF/PNG and the browser tool: a CDP endpoint, or a local binary
BROWSER_CDP_URL=
CHROME_PATH=
# Encodes widget animations to MP4 (frames rendered in Chromium). Without it widgets offer no video.
FFMPEG_PATH=ffmpeg
# Agent sandbox (shell/code): docker | agentos | off
#   docker   one container per run from SANDBOX_IMAGE; needs the host's Docker
#   agentos  one agentOS VM per run in a helper process, no Docker (macOS, glibc Linux): bash,
#            coreutils, curl, git, jq, sqlite3, zip, node and npm, Python 3.13 as Pyodide with
#            numpy and pandas; no native programs. Not part of the package: `wizards sandbox add`
#            (or `node apps/runtime/dist/sandbox/install.js agentos`) installs it into
#            SANDBOX_ENGINES_DIR
#   off      no shell/code tool (SANDBOX_ENABLED=0 does the same)
# Empty: docker when SANDBOX_IMAGE is on this machine, else agentos when it is installed, else off.
SANDBOX=
SANDBOX_IMAGE=engenty-sandbox:latest
# Where the engines that aren't part of the package are installed, one folder each.
# Empty: ~/.engenty/wizards/engines (/opt/engines in the image)
SANDBOX_ENGINES_DIR=
# Hosts an agentOS VM reaches besides the npm and PyPI registries, comma-separated. Everything
# else is refused, this server's own addresses and private networks included.
SANDBOX_ALLOW_HOSTS=
