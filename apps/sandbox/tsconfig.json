{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node runs the sources as they are (type stripping): no build, `.ts` in the imports.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test"]
}
