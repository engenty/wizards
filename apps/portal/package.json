{
  "name": "@engenty/wizards-portal",
  "version": "0.1.0",
  "description": "The client portal of engenty wizards: a firm's clients at <team>.wizards.page/portal, on the client contract of a runtime.",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm dev:server\" \"vite\"",
    "dev:server": "tsx watch --conditions=wizards-source server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@engenty/wizards-runner": "workspace:*",
    "@engenty/wizards-shared": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  }
}
