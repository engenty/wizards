{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": [
      "apps/runtime/src/**",
      "apps/runtime/*.ts",
      "apps/web/src/**",
      "apps/web/*.ts",
      "apps/web/scripts/**",
      "packages/shared/src/**",
      "packages/wizards/src/**",
      "packages/wizards/*.ts",
      "packages/wizards/scripts/**",
      "packages/runner/src/**",
      "packages/runner/*.ts",
      "packages/runner/scripts/**",
      "examples/openui-chat/src/**",
      "examples/openui-chat/*.ts",
      "scripts/*.ts",
      "scripts/*.mjs",
      "bin/*.mjs",
      "apps/docs/app/**",
      "apps/docs/components/**",
      "apps/docs/lib/**",
      "apps/docs/*.ts",
      "apps/docs/*.tsx",
      "apps/docs/*.mjs",
      "!apps/runtime/src/services/engenty-shapes.ts",
      "modules/**",
      "examples/plugins/**",
      "!apps/runtime/src/db/migrations",
      "!apps/runtime/src/engenty",
      "apps/runtime/src/engenty/shims/**",
      "!apps/web/src/engenty",
      "!packages/shared/src/engenty",
      "!!**/.claude",
      "!!**/dist"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": "off",
        "noAutofocus": "off"
      },
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noExcessiveCognitiveComplexity": "off" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
